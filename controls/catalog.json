{
  "$schema": "./catalog.schema.json",
  "version": "2.0.0",
  "attackVersion": "16",
  "benchmarks": {
    "ws2022": "CIS Microsoft Windows Server 2022 Benchmark v5.1.0"
  },
  "controls": [
    {
      "id": "CRED-01",
      "title": "Run LSASS as a protected process (LSA protection)",
      "area": "Credential protection",
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1003.001", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": true,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RunAsPPL", "value": 1 }
      ],
      "rationale": "Stops non-protected processes, including most credential dumping tools, from reading LSASS memory. CIS only lists this under its Next Generation Windows Security profile (18.9.27.2), so it's applied here as extra hardening."
    },
    {
      "id": "CRED-02",
      "title": "Disable WDigest cleartext credential caching",
      "area": "Credential protection",
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1003.001", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\Wdigest", "name": "UseLogonCredential", "value": 0 }
      ],
      "rationale": "Prevents LSASS from holding reversible copies of user passwords in memory. CIS dropped this in v5 because it's already the default; setting it explicitly stops anything turning it back on."
    },
    {
      "id": "CRED-03",
      "title": "Block anonymous enumeration of SAM accounts and shares",
      "area": "Credential protection",
      "cis": { "ws2022": ["2.3.10.2", "2.3.10.3"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms"],
      "platforms": ["azure", "vsphere"],
      "mitre": [
        { "id": "T1087.001", "relation": "mitigates" },
        { "id": "T1135", "relation": "mitigates" }
      ],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RestrictAnonymousSAM", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "RestrictAnonymous", "value": 1 }
      ],
      "rationale": "Stops unauthenticated users from listing accounts and shares, which attackers use for reconnaissance."
    },
    {
      "id": "CRED-04",
      "title": "Block Microsoft accounts",
      "area": "Credential protection",
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System", "name": "NoConnectedUser", "value": 3 }
      ],
      "rationale": "Servers should only use domain or local accounts, not personal Microsoft accounts. CIS dropped this in v5; kept as extra hardening."
    },
    {
      "id": "CRED-05",
      "title": "Cache no more than 4 previous logons",
      "area": "Credential protection",
      "cis": { "ws2022": ["2.3.7.6"] },
      "level": 2,
      "os": ["ws2022"],
      "roles": ["ms"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1003.005", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\Winlogon", "name": "CachedLogonsCount", "value": "4", "kind": "String" }
      ],
      "rationale": "Fewer cached domain credentials on the server means fewer password hashes for an attacker to dump and crack offline."
    },
    {
      "id": "NET-01",
      "title": "Allow NTLMv2 only; refuse LM and NTLMv1",
      "area": "Authentication",
      "cis": { "ws2022": ["2.3.11.7"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [
        { "id": "T1557.001", "relation": "mitigates" },
        { "id": "T1110.002", "relation": "mitigates" }
      ],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "LmCompatibilityLevel", "value": 5 }
      ],
      "rationale": "LM and NTLMv1 responses can be cracked quickly; level 5 refuses them entirely."
    },
    {
      "id": "NET-02",
      "title": "Require SMB signing (server and client)",
      "area": "Authentication",
      "cis": { "ws2022": ["2.3.8.1", "2.3.9.2"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1557.001", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters", "name": "RequireSecuritySignature", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\LanmanWorkstation\\Parameters", "name": "RequireSecuritySignature", "value": 1 }
      ],
      "rationale": "Signed SMB traffic can't be tampered with or relayed by an attacker in the middle."
    },
    {
      "id": "SURF-01",
      "title": "Remove SMBv1",
      "area": "Attack surface",
      "cis": { "ws2022": ["18.4.2", "18.4.3"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1210", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": true,
      "type": "feature",
      "feature": "FS-SMB1",
      "rationale": "SMBv1 is obsolete and was the entry point for WannaCry and NotPetya."
    },
    {
      "id": "SURF-02",
      "title": "Remove the PowerShell v2 engine",
      "area": "Attack surface",
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1562.010", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": true,
      "type": "feature",
      "feature": "PowerShell-V2",
      "rationale": "PowerShell v2 has no script block logging or AMSI, so attackers downgrade to it to avoid detection."
    },
    {
      "id": "NAME-01",
      "title": "Disable LLMNR",
      "area": "Name resolution",
      "cis": { "ws2022": ["18.6.4.4"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1557.001", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\DNSClient", "name": "EnableMulticast", "value": 0 }
      ],
      "rationale": "LLMNR answers can be spoofed on the local network to capture password hashes."
    },
    {
      "id": "NAME-02",
      "title": "Disable NetBIOS over TCP/IP (re-applied at every boot)",
      "area": "Name resolution",
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1557.001", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "script",
      "apply": "scripts/NAME-02.apply.ps1",
      "test": "scripts/NAME-02.test.ps1",
      "rationale": "NetBIOS name responses can be spoofed like LLMNR. A startup task covers NICs added after the image is built."
    },
    {
      "id": "RDP-01",
      "title": "Harden Remote Desktop (NLA, TLS, high encryption, no drive redirection)",
      "area": "Remote Desktop",
      "cis": { "ws2022": ["18.10.57.3.9.4", "18.10.57.3.9.3", "18.10.57.3.9.5", "18.10.57.3.3.3"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1021.001", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services", "name": "UserAuthentication", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services", "name": "SecurityLayer", "value": 2 },
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services", "name": "MinEncryptionLevel", "value": 3 },
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services", "name": "fDisableCdm", "value": 1 }
      ],
      "rationale": "Requires authentication before a session starts, encrypts the connection, and stops files being copied through mapped drives."
    },
    {
      "id": "RDP-02",
      "title": "Block COM, LPT and Plug and Play device redirection over RDP",
      "area": "Remote Desktop",
      "cis": { "ws2022": ["18.10.57.3.3.2", "18.10.57.3.3.5", "18.10.57.3.3.6"] },
      "level": 2,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services", "name": "fDisableCcm", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services", "name": "fDisableLPT", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows NT\\Terminal Services", "name": "fDisablePNPRedir", "value": 1 }
      ],
      "rationale": "Stops a remote session from connecting client-side serial, parallel and USB-style devices to the server."
    },
    {
      "id": "LOG-01",
      "title": "Enable PowerShell script block logging",
      "area": "PowerShell logging",
      "cis": { "ws2022": ["18.10.88.1"] },
      "level": 2,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1059.001", "relation": "detects" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ScriptBlockLogging", "name": "EnableScriptBlockLogging", "value": 1 }
      ],
      "rationale": "Records the full text of PowerShell code as it runs, including deobfuscated code, so attacker scripts show up in the event log."
    },
    {
      "id": "LOG-02",
      "title": "Increase the PowerShell Operational log to 256 MB",
      "area": "PowerShell logging",
      "level": 2,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1059.001", "relation": "detects" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "eventlog",
      "log": "Microsoft-Windows-PowerShell/Operational",
      "maxSizeBytes": 268435456,
      "rationale": "Script block logging is noisy; a larger log keeps enough history to be useful."
    },
    {
      "id": "LOG-03",
      "title": "Enable PowerShell module logging for all modules",
      "area": "PowerShell logging",
      "level": 2,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1059.001", "relation": "detects" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ModuleLogging", "name": "EnableModuleLogging", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ModuleLogging\\ModuleNames", "name": "*", "value": "*", "kind": "String" }
      ],
      "rationale": "Logs pipeline execution details for every module. Not a CIS recommendation, but it fills gaps script block logging misses."
    },
    {
      "id": "CRYPTO-01",
      "title": "Disable SSL 2.0/3.0 and TLS 1.0/1.1; enable TLS 1.2",
      "area": "Cryptography",
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1557", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": true,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\SSL 2.0\\Client", "name": "Enabled", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\SSL 2.0\\Client", "name": "DisabledByDefault", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\SSL 2.0\\Server", "name": "Enabled", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\SSL 2.0\\Server", "name": "DisabledByDefault", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\SSL 3.0\\Client", "name": "Enabled", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\SSL 3.0\\Client", "name": "DisabledByDefault", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\SSL 3.0\\Server", "name": "Enabled", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\SSL 3.0\\Server", "name": "DisabledByDefault", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.0\\Client", "name": "Enabled", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.0\\Client", "name": "DisabledByDefault", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.0\\Server", "name": "Enabled", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.0\\Server", "name": "DisabledByDefault", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.1\\Client", "name": "Enabled", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.1\\Client", "name": "DisabledByDefault", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.1\\Server", "name": "Enabled", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.1\\Server", "name": "DisabledByDefault", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.2\\Client", "name": "Enabled", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.2\\Client", "name": "DisabledByDefault", "value": 0 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.2\\Server", "name": "Enabled", "value": 1 },
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\SecurityProviders\\SCHANNEL\\Protocols\\TLS 1.2\\Server", "name": "DisabledByDefault", "value": 0 }
      ],
      "rationale": "Old SSL/TLS versions have known weaknesses (POODLE, BEAST) and fail modern compliance requirements."
    },
    {
      "id": "CRYPTO-02",
      "title": "Make .NET Framework use strong cryptography and OS TLS defaults",
      "area": "Cryptography",
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1557", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Microsoft\\.NETFramework\\v4.0.30319", "name": "SchUseStrongCrypto", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\Microsoft\\.NETFramework\\v4.0.30319", "name": "SystemDefaultTlsVersions", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\.NETFramework\\v4.0.30319", "name": "SchUseStrongCrypto", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\.NETFramework\\v4.0.30319", "name": "SystemDefaultTlsVersions", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\Microsoft\\.NETFramework\\v2.0.50727", "name": "SchUseStrongCrypto", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\Microsoft\\.NETFramework\\v2.0.50727", "name": "SystemDefaultTlsVersions", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\.NETFramework\\v2.0.50727", "name": "SchUseStrongCrypto", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\.NETFramework\\v2.0.50727", "name": "SystemDefaultTlsVersions", "value": 1 }
      ],
      "rationale": "Without these, older .NET applications can still negotiate TLS 1.0 even after Schannel is hardened."
    },
    {
      "id": "URA-01",
      "title": "Deny network logon to Guests and local accounts",
      "area": "User rights",
      "cis": { "ws2022": ["2.2.21"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms"],
      "platforms": ["azure", "vsphere"],
      "mitre": [
        { "id": "T1021.002", "relation": "mitigates" },
        { "id": "T1550.002", "relation": "mitigates" }
      ],
      "enabledByDefault": false,
      "requiresReboot": false,
      "type": "script",
      "apply": "scripts/DenyNetworkLogon.apply.ps1",
      "test": "scripts/DenyNetworkLogon.test.ps1",
      "parameters": { "sids": ["*S-1-5-32-546", "*S-1-5-114"] },
      "rationale": "Stops local accounts being used to move between servers. Off by default because in a domain this belongs in Group Policy."
    },
    {
      "id": "URA-02",
      "title": "Deny network logon to Guests (domain controllers)",
      "area": "User rights",
      "cis": { "ws2022": ["2.2.20"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1021.002", "relation": "mitigates" }],
      "enabledByDefault": false,
      "requiresReboot": false,
      "type": "script",
      "apply": "scripts/DenyNetworkLogon.apply.ps1",
      "test": "scripts/DenyNetworkLogon.test.ps1",
      "parameters": { "sids": ["*S-1-5-32-546"] },
      "rationale": "The DC version of URA-01. Domain controllers have no local accounts, so only Guests are denied. Off by default because in a domain this belongs in the Default Domain Controllers Policy."
    },
    {
      "id": "AUDIT-01",
      "title": "Force advanced audit policy and include command lines in process events",
      "area": "Auditing",
      "cis": { "ws2022": ["2.3.2.1", "18.9.3.1"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1059", "relation": "detects" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Lsa", "name": "SCENoApplyLegacyAuditPolicy", "value": 1 },
        { "path": "HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\Audit", "name": "ProcessCreationIncludeCmdLine_Enabled", "value": 1 }
      ],
      "rationale": "Makes the subcategory settings below take precedence, and records the full command line of every new process."
    },
    {
      "id": "AUDIT-02",
      "title": "Configure advanced audit policy subcategories",
      "area": "Auditing",
      "cis": { "ws2022": ["17.1.1", "17.5.4", "17.5.6", "17.5.1", "17.2.6", "17.2.5", "17.3.2", "17.9.4", "17.6.3", "17.7.1", "17.8.1"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [
        { "id": "T1078", "relation": "detects" },
        { "id": "T1110", "relation": "detects" },
        { "id": "T1098", "relation": "detects" },
        { "id": "T1136", "relation": "detects" }
      ],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "auditpol",
      "subcategories": [
        { "guid": "{0CCE923F-69AE-11D9-BED3-505054503030}", "name": "Credential Validation", "success": true, "failure": true },
        { "guid": "{0CCE9215-69AE-11D9-BED3-505054503030}", "name": "Logon", "success": true, "failure": true },
        { "guid": "{0CCE921B-69AE-11D9-BED3-505054503030}", "name": "Special Logon", "success": true, "failure": false },
        { "guid": "{0CCE9217-69AE-11D9-BED3-505054503030}", "name": "Account Lockout", "success": false, "failure": true },
        { "guid": "{0CCE9235-69AE-11D9-BED3-505054503030}", "name": "User Account Management", "success": true, "failure": true },
        { "guid": "{0CCE9237-69AE-11D9-BED3-505054503030}", "name": "Security Group Management", "success": true, "failure": true },
        { "guid": "{0CCE922B-69AE-11D9-BED3-505054503030}", "name": "Process Creation", "success": true, "failure": false },
        { "guid": "{0CCE9211-69AE-11D9-BED3-505054503030}", "name": "Security System Extension", "success": true, "failure": true },
        { "guid": "{0CCE9227-69AE-11D9-BED3-505054503030}", "name": "Other Object Access Events", "success": true, "failure": true },
        { "guid": "{0CCE922F-69AE-11D9-BED3-505054503030}", "name": "Audit Policy Change", "success": true, "failure": true },
        { "guid": "{0CCE9228-69AE-11D9-BED3-505054503030}", "name": "Sensitive Privilege Use", "success": true, "failure": false }
      ],
      "rationale": "Records logons, account changes, process creation and policy changes, which are the events an investigation needs first."
    },
    {
      "id": "AUDIT-03",
      "title": "Set the Security event log to 1 GB and overwrite as needed",
      "area": "Auditing",
      "cis": { "ws2022": ["18.10.26.2.1", "18.10.26.2.2"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["ms", "dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "rationale": "The default size overwrites events within hours on a busy server, before anyone can look at them.",
      "settings": [
        { "path": "HKLM:\\SOFTWARE\\Policies\\Microsoft\\Windows\\EventLog\\Security", "name": "MaxSize", "value": 1048576 },
