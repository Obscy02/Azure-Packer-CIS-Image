      "id": "DC-01",
      "title": "Require LDAP signing on domain controllers",
      "area": "Domain controller",
      "cis": { "ws2022": ["2.3.5.4"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1557", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Parameters", "name": "LDAPServerIntegrity", "value": 2 }
      ],
      "rationale": "Unsigned LDAP binds can be tampered with or relayed by an attacker in the middle."
    },
    {
      "id": "DC-02",
      "title": "Always require LDAP channel binding on domain controllers",
      "area": "Domain controller",
      "cis": { "ws2022": ["2.3.5.3"] },
      "level": 1,
      "os": ["ws2022"],
      "roles": ["dc"],
      "platforms": ["azure", "vsphere"],
      "mitre": [{ "id": "T1557", "relation": "mitigates" }],
      "enabledByDefault": true,
      "requiresReboot": false,
      "type": "registry",
      "settings": [
        { "path": "HKLM:\\SYSTEM\\CurrentControlSet\\Services\\NTDS\\Parameters", "name": "LdapEnforceChannelBinding", "value": 2 }
      ],
      "rationale": "Ties LDAPS authentication to the TLS session, which stops credentials being relayed into LDAP over TLS."
    },
